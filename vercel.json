{
  "rewrites": [
    {
      "source": "/api/supabase/:path*",
      "destination": "https://vibegram-edge-gw.vercel.app/:path*"
    },
    {
      "source": "/rest/v1/:path*",
      "destination": "https://vibegram-edge-gw.vercel.app/rest/v1/:path*"
    },
    {
      "source": "/auth/v1/:path*",
      "destination": "https://vibegram-edge-gw.vercel.app/auth/v1/:path*"
    },
    {
      "source": "/storage/v1/:path*",
      "destination": "https://vibegram-edge-gw.vercel.app/storage/v1/:path*"
    },
    {
      "source": "/functions/v1/:path*",
      "destination": "https://vibegram-edge-gw.vercel.app/functions/v1/:path*"
    },
    {
      "source": "/realtime/v1/:path*",
      "destination": "https://vibegram-edge-gw.vercel.app/realtime/v1/:path*"
    },
    {
      "source": "/cloudinary/:path*",
      "destination": "https://vibegram-edge-gw.vercel.app/cloudinary/:path*"
    },
    {
      "source": "/cloudinary-api/:path*",
      "destination": "https://vibegram-edge-gw.vercel.app/cloudinary-api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, PATCH, DELETE, OPTIONS, HEAD" },
        { "key": "Access-Control-Allow-Headers", "value": "Authorization, apikey, Content-Type, Prefer, Range, x-client-info, Content-Profile, Accept-Profile, accept-profile, content-profile, x-supabase-api-version" },
        { "key": "Access-Control-Expose-Headers", "value": "Content-Range, Range-Unit, Accept-Ranges, Content-Length" }
      ]
    }
  ]
}
